# Only used by `npm run estimate-fee` (src/estimateFee.ts) — the optional
# fee-estimation walkthrough against the older, single-circuit
# contracts/verifier. The main demo (`npm run demo` / `npm start`) targets
# contracts/registry, needs no auth, and reads no environment variables.
#
# Not loaded automatically — export this in your shell (`export
# SOROBAN_SECRET_KEY=...`) before running `npm run estimate-fee`; this
# file is documentation, not a real .env loader.
SOROBAN_SECRET_KEY=
